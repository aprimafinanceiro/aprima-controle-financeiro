      "typeVersion": 4.1,
      "position": [1450, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{$json.pageId}}/photos",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{$json.accessToken}}"
            },
            {
              "name": "published",
              "value": "false"
            }
