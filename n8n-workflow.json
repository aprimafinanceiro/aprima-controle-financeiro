              "batchInterval": 1000
            }
          }
        }
      },
      "id": "upload-facebook",
      "name": "Upload Foto Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1650, 100]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "merge-fotos",
      "name": "Agrupar Fotos",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [1850, 100]
    },
    {
      "parameters": {
        "functionCode": "// Agrupa IDs das fotos\nconst photoIds = $input.all().map(item => ({\n  id: item.json.id\n}));\n\nconst firstItem = $input.first().json;\n\nreturn [{\n  json: {\n    photoIds: photoIds,\n    titulo: firstItem.titulo,\n    descricao: firstItem.descricao,\n    preco: firstItem.preco,\n    tipo: firstItem.tipo,\n    transacao: firstItem.transacao,\n    pageId: firstItem.pageId,\n    accessToken: firstItem.accessToken,\n    imovelId: firstItem.imovelId\n  }\n}];"
      },
      "id": "agrupar-ids",
      "name": "Agrupar IDs das Fotos",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [2050, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{$json.pageId}}/marketplace_listings",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{$json.accessToken}}"
            },
            {
              "name": "name",
              "value": "={{$json.titulo}}"
            },
            {
              "name": "description",
              "value": "={{$json.descricao}}"
            },
            {
              "name": "price",
              "value": "={{$json.preco}}"
            },
            {
              "name": "currency",
              "value": "BRL"
            },
            {
              "name": "availability",
              "value": "AVAILABLE"
            },
            {
              "name": "condition",
              "value": "NEW"
            },
            {
              "name": "category",
              "value": "={{$json.transacao === 'aluguel' ? 'property_for_rent' : 'property_for_sale'}}"
            },
            {
              "name": "images",
              "value": "={{JSON.stringify($json.photoIds)}}"
            }
          ]
        }
      },
      "id": "criar-listing",
      "name": "Criar Anúncio Facebook",
